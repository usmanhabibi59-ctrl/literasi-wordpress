{
	"version": 3,
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"title": "IBM Plex Serif & IBM Plex Sans",
	"slug": "typography-preset-4",
	"settings": {
		"typography": {
			"fontFamilies": [
				{
					"name": "IBM Plex Serif",
					"slug": "primary",
					"fontFamily": "IBM Plex Serif, serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/ibm-plex-serif/IBMPlexSerif-Regular.ttf"
							],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "IBM Plex Serif"
						},
						{
							"src": [
								"file:./assets/fonts/ibm-plex-serif/IBMPlexSerif-Medium.ttf"
							],
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontFamily": "IBM Plex Serif"
						},
						{
							"src": [
								"file:./assets/fonts/ibm-plex-serif/IBMPlexSerif-SemiBold.ttf"
							],
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontFamily": "IBM Plex Serif"
						},
						{
							"src": [
								"file:./assets/fonts/ibm-plex-serif/IBMPlexSerif-Bold.ttf"
							],
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontFamily": "IBM Plex Serif"
						}
					]
				},
				{
					"name": "IBM Plex Sans",
					"slug": "accent",
					"fontFamily": "IBM Plex Sans, sans-serif",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf"
							]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/ibm-plex-sans/IBMPlexSans-Medium.ttf"
							]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBold.ttf"
							]
						},
						{
							"fontFamily": "IBM Plex Sans",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/ibm-plex-sans/IBMPlexSans-Bold.ttf"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|primary",
			"fontSize": "var:preset|font-size|medium",
			"letterSpacing": "-0.18px",
			"lineHeight": "1.5"
		},
		"blocks": {
			"core/post-author-name": {
				"typography": {
					"fontWeight": "400"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontWeight": "400"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|accent",
					"fontWeight": "400",
					"letterSpacing": "-0.96px"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|accent",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "400"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontFamily": "var:preset|font-family|accent",
							"fontWeight": "400",
							"letterSpacing": "-0.14px"
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|accent",
					"fontWeight": "600",
					"letterSpacing": "-0.18px"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|accent",
					"fontSize": "var:preset|font-size|x-large"
				}
			}
		}
	}
}